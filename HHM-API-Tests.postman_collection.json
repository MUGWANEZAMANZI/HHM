{
  "info": {
    "name": "HHM API — Security & RBAC Tests",
    "description": "Full RBAC test suite for the Hospital Health Management System.\n\nSetup:\n1. Start the app: mvn spring-boot:run -Dspring-boot.run.profiles=dev\n2. Import this collection into Postman.\n3. Run the 'Auth' folder first — it stores tokens as collection variables.\n4. Run other folders in any order.\n\nSeeded accounts (created on first boot):\n  Admin   : admin@hhm.rw   / admin123\n  Doctor  : doctor1@hhm.rw / doctor123\n  Nurse   : nurse1@hhm.rw  / nurse123\n  Patient : patient1@hhm.rw / patient123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:8080" },
    { "key": "adminToken",       "value": "" },
    { "key": "doctorToken",      "value": "" },
    { "key": "nurseToken",       "value": "" },
    { "key": "patientToken",     "value": "" },
    { "key": "receptionistToken","value": "" }
  ],
  "item": [

    {
      "name": "1 — Auth",
      "item": [

        {
          "name": "Login as Admin (saves adminToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('token present', () => pm.expect(json.token).to.be.a('string'));",
            "pm.collectionVariables.set('adminToken', json.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@hhm.rw\",\n  \"password\": \"admin123\"\n}" }
          }
        },

        {
          "name": "Login as Doctor (saves doctorToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('doctorToken', json.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"doctor1@hhm.rw\",\n  \"password\": \"doctor123\"\n}" }
          }
        },

        {
          "name": "Login as Nurse (saves nurseToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('nurseToken', json.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nurse1@hhm.rw\",\n  \"password\": \"nurse123\"\n}" }
          }
        },

        {
          "name": "Login as Patient (saves patientToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('patientToken', json.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient1@hhm.rw\",\n  \"password\": \"patient123\"\n}" }
          }
        },

        {
          "name": "Register Patient — public (201)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201 — patient self-registration allowed', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Patient\",\n  \"email\": \"testpatient99@hhm.rw\",\n  \"password\": \"pass1234\",\n  \"type\": \"PATIENT\",\n  \"phone\": \"0789999999\"\n}" }
          }
        },

        {
          "name": "Register ADMIN without auth — 403 (type blocked)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403 — non-PATIENT registration blocked', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hacker Admin\",\n  \"email\": \"hacker@evil.com\",\n  \"password\": \"pass1234\",\n  \"type\": \"ADMIN\"\n}" }
          }
        },

        {
          "name": "Logout Admin (blacklists adminToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 — logged out', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },

        {
          "name": "Use blacklisted token — 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 — blacklisted token rejected', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/users"
          }
        },

        {
          "name": "Re-login Admin (refresh adminToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@hhm.rw\",\n  \"password\": \"admin123\"\n}" }
          }
        }

      ]
    },

