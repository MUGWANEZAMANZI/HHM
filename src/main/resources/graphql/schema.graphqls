# ─── Domain types ────────────────────────────────────────────────────────────

type Patient {
    id: ID!
    name: String!
    phone: String
    email: String
    address: String
}

type Doctor {
    id: ID!
    name: String!
    departmentId: ID!
    licenseNumber: String!
}

type Department {
    id: ID!
    name: String!
}

# AppointmentView is the read model — it contains joined names from Patient/Doctor/Department
type AppointmentView {
    id: ID!
    patientId: ID!
    doctorId: ID!
    patientName: String!
    patientPhone: String
    doctorName: String!
    departmentName: String
    appointmentDate: String!
    status: String!
}

type Prescription {
    id: ID!
    patientId: ID!
    doctorId: ID!
    issuedAt: String!
    status: String!
    notes: String
}

type PrescriptionItem {
    id: ID!
    prescriptionId: ID!
    medicationId: ID!
    dosage: String
    frequency: String
    quantity: Int!
    refillsAllowed: Int!
}

type PatientFeedback {
    id: ID!
    patientId: ID!
    feedback: String!
    privateNotes: String
    issuedAt: String!
}

type MedicalInventory {
    id: ID!
    name: String!
    sku: String!
    quantityOnHand: Int!
    reorderLevel: Int!
}

type PatientPage {
    content: [Patient!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
}

# ─── Queries ──────────────────────────────────────────────────────────────────

type Query {
    # Patient
    patients(search: String): [Patient!]!
    patientsPaged(page: Int, size: Int): PatientPage!
    patient(id: ID!): Patient

    # Doctor
    doctors(search: String): [Doctor!]!
    doctor(id: ID!): Doctor

    # Department
    departments: [Department!]!

    # Appointment
    appointments(search: String, status: String): [AppointmentView!]!
    appointment(id: ID!): AppointmentView

    # Prescription
    prescriptions: [Prescription!]!
    prescription(id: ID!): Prescription

    # Feedback
    feedback(search: String): [PatientFeedback!]!

    # Inventory
    inventory(search: String): [MedicalInventory!]!
    lowStockItems: [MedicalInventory!]!
}

# ─── Input types ──────────────────────────────────────────────────────────────

input RegisterPatientInput {
    name: String!
    phone: String!
    email: String!
    address: String
    district: String
    sector: String
    cell: String
    village: String
}

input RegisterDoctorInput {
    name: String!
    departmentId: ID!
    licenseNumber: String!
}

input BookAppointmentInput {
    patientId: ID!
    doctorId: ID!
    appointmentDate: String!
}

input IssuePrescriptionInput {
    patientId: ID!
    doctorId: ID!
    notes: String
}

input SubmitFeedbackInput {
    patientId: ID!
    feedback: String!
    privateNotes: String
}

input AddInventoryItemInput {
    name: String!
    sku: String!
    quantityOnHand: Int!
    reorderLevel: Int!
}

# ─── Mutations ────────────────────────────────────────────────────────────────

type Mutation {
    # Patient
    registerPatient(input: RegisterPatientInput!): String!
    deletePatient(id: ID!): Boolean!

    # Doctor
    registerDoctor(input: RegisterDoctorInput!): String!
    deleteDoctor(id: ID!): Boolean!

    # Appointment
    bookAppointment(input: BookAppointmentInput!): String!
    cancelAppointment(id: ID!): Boolean!
    deleteAppointment(id: ID!): Boolean!

    # Prescription
    issuePrescription(input: IssuePrescriptionInput!): String!
    cancelPrescription(id: ID!): Boolean!
    deletePrescription(id: ID!): Boolean!

    # Feedback
    submitFeedback(input: SubmitFeedbackInput!): String!
    deleteFeedback(id: ID!): Boolean!

    # Inventory
    addInventoryItem(input: AddInventoryItemInput!): String!
    deleteInventoryItem(id: ID!): Boolean!
}
