<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" style="-fx-background-color:#f4f6f9;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PrescriptionController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Prescription Management"
               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1e2a3a;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill:#e53935; -fx-font-size:12px;"/>
    </HBox>

    <!-- Form Card -->
    <VBox spacing="10"
          style="-fx-background-color:white; -fx-background-radius:8; -fx-effect:dropshadow(gaussian,#ccc,4,0,0,2);">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        <Label text="Prescription Details" style="-fx-font-weight:bold; -fx-text-fill:#444;"/>

        <HBox spacing="10">
            <ComboBox  fx:id="patientCombo" promptText="Select Patient" prefWidth="220"/>
            <ComboBox  fx:id="doctorCombo"  promptText="Select Doctor"  prefWidth="220"/>
            <DatePicker fx:id="datePicker"  promptText="Issue Date"     prefWidth="160"/>
            <ComboBox  fx:id="statusCombo"  promptText="Status"         prefWidth="140"/>
        </HBox>

        <HBox spacing="10" alignment="TOP_LEFT">
            <Label text="Notes:" style="-fx-text-fill:#666; -fx-padding:4 0 0 0;"/>
            <TextArea fx:id="notesArea" promptText="Prescription notes..."
                      prefWidth="500" prefHeight="60" wrapText="true"/>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="saveBtn" text="Issue Prescription" onAction="#onSave"
                    style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Clear" onAction="#onClear"
                    style="-fx-background-color:#90a4ae; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Delete Selected" onAction="#onDelete"
                    style="-fx-background-color:#e53935; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
        </HBox>
    </VBox>

    <!-- Search bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" prefWidth="280" promptText="Search by patient or doctor name..."/>
        <ComboBox  fx:id="filterStatus" promptText="Filter by status" prefWidth="160"/>
        <Button text="Search"   onAction="#onSearch"
                style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
        <Button text="Show All" onAction="#onShowAll"
                style="-fx-background-color:#546e7a; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="prescriptionTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color:white; -fx-background-radius:8;">
        <columns>
            <TableColumn fx:id="colId"      text="ID"       prefWidth="50"/>
            <TableColumn fx:id="colPatient" text="Patient"  prefWidth="180"/>
            <TableColumn fx:id="colDoctor"  text="Doctor"   prefWidth="180"/>
            <TableColumn fx:id="colDate"    text="Issued"   prefWidth="110"/>
            <TableColumn fx:id="colStatus"  text="Status"   prefWidth="110"/>
            <TableColumn fx:id="colNotes"   text="Notes"    prefWidth="300"/>
        </columns>
    </TableView>

</VBox>
