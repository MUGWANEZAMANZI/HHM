<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="680" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HomeController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="200" spacing="4" style="-fx-background-color:#1e2a3a;">
            <padding><Insets bottom="20" left="0" right="0" top="30" /></padding>

            <Label style="-fx-text-fill:white; -fx-font-size:16px; -fx-font-weight:bold; -fx-padding:0 0 20 20;" text="HHM System" />

            <Button maxWidth="Infinity" onAction="#showDashboard" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Dashboard" />
            <Button maxWidth="Infinity" onAction="#showPatients" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Patients" />
            <Button maxWidth="Infinity" onAction="#showDoctors" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Doctors" />
            <Button maxWidth="Infinity" onAction="#showAppointments" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Appointments" />
            <Button maxWidth="Infinity" onAction="#showPrescriptions" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Prescriptions" />
            <Button maxWidth="Infinity" onAction="#showInventory" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Inventory" />
            <Button maxWidth="Infinity" onAction="#showFeedback" style="-fx-background-color:transparent; -fx-text-fill:#aab4c4; -fx-font-size:13px; -fx-alignment:center-left; -fx-padding:10 20;" text="Feedback" />
        </VBox>
    </left>

    <!-- Main content area — swapped by HomeController -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color:#f4f6f9;">
            <VBox alignment="CENTER" spacing="12">
                <Label style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#1e2a3a;" text="Welcome to Hospital Health Management" />
                <Label style="-fx-text-fill:#666;" text="Select a section from the sidebar to get started." />
                <Label fx:id="time" text="Time">
               <font>
                  <Font size="43.0" />
               </font></Label>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
