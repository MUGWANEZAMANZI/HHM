<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DoctorController"
      style="-fx-background-color:#f4f6f9;">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Doctor Management"
               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1e2a3a;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill:#e53935; -fx-font-size:12px;"/>
    </HBox>

    <!-- Form Card -->
    <VBox style="-fx-background-color:white; -fx-background-radius:8; -fx-effect:dropshadow(gaussian,#ccc,4,0,0,2);"
          spacing="10">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        <Label text="Doctor Details" style="-fx-font-weight:bold; -fx-text-fill:#444;"/>

        <HBox spacing="10">
            <TextField fx:id="nameField"    promptText="Full Name"      prefWidth="220"/>
            <TextField fx:id="licenseField" promptText="License Number" prefWidth="180"/>
            <ComboBox  fx:id="departmentCombo" promptText="Select Department" prefWidth="200"/>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="saveBtn" text="Save Doctor" onAction="#onSave"
                    style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Clear" onAction="#onClear"
                    style="-fx-background-color:#90a4ae; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Delete Selected" onAction="#onDelete"
                    style="-fx-background-color:#e53935; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
        </HBox>
    </VBox>

    <!-- Search bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by name or license..." prefWidth="300"/>
        <Button text="Search"   onAction="#onSearch"
                style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
        <Button text="Show All" onAction="#onShowAll"
                style="-fx-background-color:#546e7a; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color:white; -fx-background-radius:8;">
        <columns>
            <TableColumn fx:id="colId"         text="ID"           prefWidth="55"/>
            <TableColumn fx:id="colName"       text="Name"         prefWidth="220"/>
            <TableColumn fx:id="colDepartment" text="Department"   prefWidth="180"/>
            <TableColumn fx:id="colLicense"    text="License No."  prefWidth="180"/>
        </columns>
    </TableView>

</VBox>
