<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" style="-fx-background-color:#f4f6f9;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.InventoryController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Medical Inventory"
               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1e2a3a;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill:#e53935; -fx-font-size:12px;"/>
    </HBox>

    <!-- Form Card -->
    <VBox spacing="10"
          style="-fx-background-color:white; -fx-background-radius:8; -fx-effect:dropshadow(gaussian,#ccc,4,0,0,2);">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        <Label text="Item Details" style="-fx-font-weight:bold; -fx-text-fill:#444;"/>

        <HBox spacing="10">
            <TextField fx:id="nameField"     promptText="Item Name"        prefWidth="220"/>
            <TextField fx:id="skuField"      promptText="SKU"              prefWidth="140"/>
            <TextField fx:id="qtyField"      promptText="Quantity on Hand" prefWidth="150"/>
            <TextField fx:id="reorderField"  promptText="Reorder Level"    prefWidth="140"/>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="saveBtn" text="Save Item" onAction="#onSave"
                    style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Clear" onAction="#onClear"
                    style="-fx-background-color:#90a4ae; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Delete Selected" onAction="#onDelete"
                    style="-fx-background-color:#e53935; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
            <Button text="Show Low Stock" onAction="#onLowStock"
                    style="-fx-background-color:#f57c00; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 18;"/>
        </HBox>
    </VBox>

    <!-- Search bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" prefWidth="300" promptText="Search by name or SKU..."/>
        <Button text="Search"   onAction="#onSearch"
                style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
        <Button text="Show All" onAction="#onShowAll"
                style="-fx-background-color:#546e7a; -fx-text-fill:white; -fx-background-radius:4; -fx-padding:7 14;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color:white; -fx-background-radius:8;">
        <columns>
            <TableColumn fx:id="colId"      text="ID"             prefWidth="55"/>
            <TableColumn fx:id="colName"    text="Item Name"      prefWidth="220"/>
            <TableColumn fx:id="colSku"     text="SKU"            prefWidth="130"/>
            <TableColumn fx:id="colQty"     text="Qty on Hand"    prefWidth="120"/>
            <TableColumn fx:id="colReorder" text="Reorder Level"  prefWidth="120"/>
            <TableColumn fx:id="colStock"   text="Stock Status"   prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
